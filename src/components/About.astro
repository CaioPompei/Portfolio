---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));

const tools = [
  { label: t("about.backend"), items: "C#, .NET, Go, Python" },
  { label: t("about.frontend"), items: "JavaScript, HTML, CSS, Astro" },
  { label: t("about.data"), items: "MySQL, JSON, CSV" },
];
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="container section about__inner">
    <h2 id="about-title" class="section-title">{t("about.title")}</h2>
    <div class="about__text">
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
    </div>
    <div class="about__tools">
      <h3>{t("about.tools")}</h3>
      <dl>
        {tools.map((g) => (
          <div>
            <dt class="muted">{g.label}</dt>
            <dd>{g.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--paper-2);
  }
  .about__inner {
    display: grid;
    row-gap: 2.5rem;
  }
  .about__inner .section-title {
    grid-column: 1 / -1;
  }
  .about__text {
    display: grid;
    gap: 1.1rem;
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .about__tools h3 {
    font-size: var(--step-0);
    margin-bottom: 1rem;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  dd {
    margin: 0;
  }
  @media (min-width: 52rem) {
    .about__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: clamp(1.25rem, 0.5rem + 3vw, 3.5rem);
      row-gap: 0;
    }
  }
</style>
