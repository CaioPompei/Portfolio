---
import { getLangFromUrl, useTranslations, projectPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero container">
  <div class="hero__text">
    <h1 class="hero__name">Caio<br />Pompei</h1>
    <p class="hero__intro">{t("hero.intro")}</p>
  </div>

  <figure class="hero__portal">
    <canvas class="portal" aria-hidden="true"></canvas>
    <figcaption>
      <a href={projectPath(lang, "noneuc-game-engine")}>{t("hero.portal")}</a>
      <span class="hero__hint muted">{t("hero.portalHint")}</span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(3rem, 2rem + 6vw, 7rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  .hero__name {
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin-left: -0.04em;
  }
  .hero__intro {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .hero__portal {
    margin: 0;
  }
  .portal {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--paper-2);
    border-radius: var(--radius);
    touch-action: pan-y;
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.85rem;
    font-size: var(--step--1);
  }
  figcaption a {
    font-weight: 600;
  }
  @media (hover: none) {
    .hero__hint {
      display: none;
    }
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .portal {
      aspect-ratio: 1 / 1;
    }
  }
</style>

<script>
  /*
    Recursive portal: each frame is the view through the previous one.
    The offset between frames follows the pointer, so the tunnel bends
    the way a camera behind a stencil portal would.
  */
  const canvas = document.querySelector<HTMLCanvasElement>(".portal");
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const DEPTH = 9;
    const SHRINK = 0.78;

    let w = 0, h = 0, dpr = 1;
    let colors = { a: "", b: "", ink: "" };
    const target = { x: 0.35, y: -0.2 };
    const pos = { x: 0.35, y: -0.2 };
    let pointerActive = false;
    let raf = 0;

    function readColors() {
      const s = getComputedStyle(document.documentElement);
      colors = {
        a: s.getPropertyValue("--cobalt").trim(),
        b: s.getPropertyValue("--paper").trim(),
        ink: s.getPropertyValue("--ink").trim(),
      };
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function frameCorners(i: number) {
      const scale = Math.pow(SHRINK, i);
      const fw = w * 0.62 * scale;
      const fh = h * 0.78 * scale;
      // The offset accumulates with depth, so deep frames drift furthest.
      const drift = (1 - scale) * 0.6;
      const cx = w / 2 + pos.x * w * 0.5 * drift;
      const cy = h / 2 + pos.y * h * 0.5 * drift;
      const rot = pos.x * 0.05 * i;
      const cos = Math.cos(rot), sin = Math.sin(rot);
      return [
        [-fw / 2, -fh / 2],
        [fw / 2, -fh / 2],
        [fw / 2, fh / 2],
        [-fw / 2, fh / 2],
      ].map(([x, y]) => [cx + x * cos - y * sin, cy + x * sin + y * cos]);
    }

    function path(c: number[][]) {
      ctx.beginPath();
      ctx.moveTo(c[0][0], c[0][1]);
      for (let k = 1; k < 4; k++) ctx.lineTo(c[k][0], c[k][1]);
      ctx.closePath();
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      let prev: number[][] | null = null;
      for (let i = 0; i < DEPTH; i++) {
        const c = frameCorners(i);
        path(c);
        ctx.fillStyle = i % 2 === 0 ? colors.a : colors.b;
        ctx.globalAlpha = 1;
        ctx.fill();
        // Deeper frames get a little darker, so the tunnel reads as depth.
        ctx.fillStyle = colors.ink;
        ctx.globalAlpha = i * 0.035;
        ctx.fill();

        // Walls of the tunnel: join the corners of consecutive frames.
        if (prev) {
          ctx.strokeStyle = colors.ink;
          ctx.globalAlpha = 0.18;
          ctx.lineWidth = 1;
          for (let k = 0; k < 4; k++) {
            ctx.beginPath();
            ctx.moveTo(prev[k][0], prev[k][1]);
            ctx.lineTo(c[k][0], c[k][1]);
            ctx.stroke();
          }
        }
        path(c);
        ctx.strokeStyle = colors.ink;
        ctx.globalAlpha = 0.35;
        ctx.lineWidth = 1.25;
        ctx.stroke();
        prev = c;
      }
      ctx.globalAlpha = 1;
    }

    function tick(t: number) {
      if (!pointerActive) {
        target.x = Math.sin(t / 3200) * 0.55;
        target.y = Math.cos(t / 4100) * 0.35;
      }
      pos.x += (target.x - pos.x) * 0.06;
      pos.y += (target.y - pos.y) * 0.06;
      draw();
      raf = requestAnimationFrame(tick);
    }

    function start() {
      cancelAnimationFrame(raf);
      if (reduce.matches) draw();
      else raf = requestAnimationFrame(tick);
    }

    window.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const rect = canvas.getBoundingClientRect();
      const nx = (e.clientX - (rect.left + rect.width / 2)) / (window.innerWidth / 2);
      const ny = (e.clientY - (rect.top + rect.height / 2)) / (window.innerHeight / 2);
      target.x = Math.max(-1, Math.min(1, nx));
      target.y = Math.max(-1, Math.min(1, ny));
      pointerActive = true;
    });
    document.addEventListener("mouseleave", () => (pointerActive = false));

    new ResizeObserver(() => {
      resize();
      draw();
    }).observe(canvas);

    // Pause when the hero scrolls out of view.
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) start();
      else cancelAnimationFrame(raf);
    }).observe(canvas);

    const scheme = window.matchMedia("(prefers-color-scheme: dark)");
    scheme.addEventListener("change", () => {
      readColors();
      draw();
    });
    reduce.addEventListener("change", start);

    readColors();
    resize();
    start();
  }
</script>
