---
import { getLangFromUrl, useTranslations, projectPath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
  <a class="hero__media" href={projectPath(lang, "noneuc-game-engine")} tabindex="-1" aria-hidden="true">
    <video
      src="/media/noneuc-loop.mp4"
      poster="/media/noneuc-poster.webp"
      muted
      loop
      playsinline
      preload="auto"
      data-hero
    ></video>
  </a>
  <p class="visually-hidden">{t("hero.video")}</p>
  <div class="container hero__text">
    <h1 class="hero__name">Caio Pompei</h1>
    <p class="hero__intro">{t("hero.intro")}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88svh, 52rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: #111418;
    color: #f1f3f5;
  }
  .hero__media {
    position: absolute;
    inset: 0;
  }
  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.05);
  }
  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 12 16 / 0.92) 0%, rgb(10 12 16 / 0.55) 35%, rgb(10 12 16 / 0) 70%);
  }
  .hero__text {
    position: relative;
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
    pointer-events: none;
  }
  .hero__name {
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin-left: -0.04em;
    max-width: 10ch;
  }
  .hero__intro {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    color: #c9d0d8;
  }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>("video[data-hero]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (v) {
    const sync = () => (reduce.matches ? v.pause() : v.play().catch(() => {}));
    sync();
    reduce.addEventListener("change", sync);
  }
</script>
